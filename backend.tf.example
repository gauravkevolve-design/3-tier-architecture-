terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_YOUR_TERRAFORM_STATE_BUCKET"
    key          = "3-tier-architecture/terraform.tfstate"
    region       = "ap-south-1"
    use_lockfile = true
    encrypt      = true
  }
}

# Rename this file to backend.tf after creating your own S3 state bucket.
# Never commit AWS credentials or a real terraform.tfvars file.
